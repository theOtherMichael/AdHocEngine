{
  // Prevent CMake Tools from auto-generating a launch config that points into
  // the build tree — the actual launch configs are in launch.json.
  "cmake.debugConfig": {
    "stopAtEntry": false
  },
  // Reconfigure automatically when a CMakeLists.txt / *.cmake file is saved, so a
  // newly added source gets IntelliSense flags from the CMake Tools provider
  // without a manual "CMake: Configure". (These are CMake Tools defaults; pinned
  // here so the IntelliSense-after-adding-a-file workflow can't be broken by a
  // global override. Out-of-IDE edits still need a manual configure — the running
  // extension isn't notified of CLI/agent changes.)
  "cmake.configureOnEdit": true,
  "cmake.configureOnOpen": true,
  // Disable cpptools IntelliSense — clangd takes over diagnostics, completions, and go-to-definition.
  // Keep cpptools installed for its debugger integration.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "${workspaceFolder}/tools/llvm/current/bin/clangd",
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  // CMake symlinks compile_commands.json into build/ → active build tree on
  // every configure (CMakeLists.txt section 6), so clangd always sees the
  // current preset's flags without any manual update.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--header-insertion=never"
  ]
}
